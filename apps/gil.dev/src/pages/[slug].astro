---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import Tag from "../components/Tag.astro";
import NoteCard from "../components/NoteCard.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { formatPublishDate, generateDescription } from "../lib/utils.ts";
import {
  getDailyGardenSeed,
  isDiscoverableNote,
  noteStatusEmoji,
  noteStatusLabel,
  selectRelatedNotes,
} from "../lib/notes.ts";
import "../styles/global.css";
// 1. Generate a new path for every collection note
export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug || note.id },
    props: { note },
  }));
}
// 2. When it's time to render, you can get the note directly from the prop
const { note } = Astro.props;
const { Content } = await render(note);

const {
  data: { title, created, updated, tags, topics, status, images },
} = note;

const noteHtml = marked.parse(note.body ?? "") as string;
const pageDescription = note.data.description || generateDescription(noteHtml);

const allTopics = await getCollection("topics");
const topicTitles = Object.fromEntries(
  allTopics.map((t) => [t.id, t.data.title]),
);
const discoverableNotes = await getCollection("notes", ({ data }) =>
  isDiscoverableNote(data),
);
const wanderingNotes = selectRelatedNotes(
  discoverableNotes,
  note,
  3,
  `${note.id}-${getDailyGardenSeed()}`,
);

---

<MainLayout title={title} description={pageDescription} ogImage={images?.[0] ?? undefined}>
  <article>
    <div class="mb-1">
      <time class="slab" datetime={created}>
        {formatPublishDate(created)}
      </time>
    </div>
    {
      status && (
        <div class="text-sm slab mb-2" title={noteStatusLabel[status]}>
          {noteStatusEmoji[status]} {status}
        </div>
      )
    }
    {
      topics && topics.length > 0 && (
        <div>
          <img
            src="/img/sticky-note.svg"
            style="width:24px;height:24px;flex-shrink:0;border-radius: 0px; margin:0px;"
            class="inline"
            alt="Topics Icon"
          />{" "}
          {topics.map((topic: string) => (
            <Tag
              tag={topicTitles[topic] ?? topic}
              href={`/topics/${topic}`}
              i={0}
            />
          ))}
        </div>
      )
    }
    <Content />
    <footer>
      {
        tags.length > 0 && (
          <p>
            <img
              src="/img/tags.svg"
              width="24px"
              height="24px"
              class="inline"
              alt="Tag Icon"
            />{" "}
            {note.data.tags.map((tag: any, i: number) => (
              <Tag tag={tag} i={i} />
            ))}
          </p>
        )
      }
    </footer>
  </article>
  {
    wanderingNotes.length > 0 && (
      <aside class="continue-wandering">
        <h2>Continue Wandering</h2>
        <p>Nearby ideas and another path through the garden.</p>
        <div class="continue-wandering__grid">
          {wanderingNotes.map((wanderingNote, index) => (
            <NoteCard
              note={wanderingNote}
              topicTitles={topicTitles}
              compact
              index={index}
            />
          ))}
        </div>
      </aside>
    )
  }
</MainLayout>

<style>
  .continue-wandering {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 0.15rem solid var(--yellowalpha);
  }

  .continue-wandering h2 {
    margin-bottom: 0.35rem;
  }

  .continue-wandering > p {
    color: rgba(232, 230, 223, 0.68);
    font-size: 0.65rem;
  }

  .continue-wandering__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (max-width: 700px) {
    .continue-wandering__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
