---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { formatPublishDate } from "../../lib/utils.ts";
import { getTagPaths, tagMatchesPath } from "../../lib/tags.ts";
import { isDiscoverableNote, isPublishedNote, noteStatusEmoji } from "../../lib/notes.ts";
import "../../styles/global.css";

export async function getStaticPaths() {
  const publishedNotes = await getCollection("notes", ({ data }) =>
    isPublishedNote(data),
  );
  const notes = publishedNotes.filter(({ data }) => isDiscoverableNote(data));

  const allTags = publishedNotes.flatMap((note) => note.data.tags ?? []);
  const tagPaths = getTagPaths(allTags);

  return tagPaths.map((tag) => ({
    params: { tag },
    props: {
      tag,
      notes: notes
        .filter((note) =>
          (note.data.tags ?? []).some((noteTag) => tagMatchesPath(noteTag, tag)),
        )
        .sort(
          (a, b) =>
            new Date(b.data.updated ?? b.data.created).getTime() -
            new Date(a.data.updated ?? a.data.created).getTime(),
        ),
    },
  }));
}

const { tag, notes } = Astro.props;

---

<MainLayout title={`#${tag}`} description={`Notes tagged with ${tag}`}>
  <article>
    <ul>
      {
        notes.map((note) => (
          <li>
            <a href={`/${note.data.slug || note.id}`}>
              {note.data.status && (
                <span title={note.data.status}>
                  {noteStatusEmoji[note.data.status]}{" "}
                </span>
              )}
              {note.data.title}
            </a>
            <span class="slab text-sm ml-2">
              {formatPublishDate(note.data.created)}
            </span>
          </li>
        ))
      }
    </ul>
  </article>
</MainLayout>
