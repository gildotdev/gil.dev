---
import { getCollection } from "astro:content";
import Tag from "../components/Tag.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { formatPublishDate } from "../lib/utils.ts";
import {
  isPublishedNote,
  isReferenceNote,
  noteStatusEmoji,
} from "../lib/notes.ts";
import "../styles/global.css";

const notes = await getCollection("notes", ({ data }) => {
  return isPublishedNote(data);
});
const primaryNotes = notes.filter(({ data }) => !isReferenceNote(data));
const referenceNotes = notes
  .filter(({ data }) => isReferenceNote(data))
  .sort(
    (a, b) =>
      new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime(),
  );

const allTopics = await getCollection("topics");
const topicTitles = Object.fromEntries(
  allTopics.map((t) => [t.id, t.data.title]),
);

---

<style>
  .reference-notes {
    margin-top: 2.5rem;
    opacity: 0.72;
  }

  .reference-notes summary {
    cursor: pointer;
    font-size: 0.9rem;
  }

  .reference-notes ul {
    font-size: 0.85rem;
  }

  .reference-notes li {
    margin-block: 0.35rem;
  }
</style>

<MainLayout title="Notes">
  <ul>
    {
      primaryNotes.map((note) => (
        <li>
          <a href={`/${note.data.slug || note.id}`}>
            {note.data.status && (
              <span title={note.data.status}>
                {noteStatusEmoji[note.data.status]}{" "}
              </span>
            )}
            {note.data.title}
          </a>
          <p>
            <time class="slab text-sm" datetime={note.data.created}>
              {formatPublishDate(note.data.created)}
            </time>
          </p>
          {note.data.topics && note.data.topics.length > 0 && (
            <p>
              Topics:{" "}
              {note.data.topics.map((topic: string) => (
                <a href={`/topics/${topic}`} class="mr-2 text-sm">
                  {topicTitles[topic] ?? topic}
                </a>
              ))}
            </p>
          )}
          {note.data.tags.length > 0 && (
            <p>
              Tags:{" "}
              {note.data.tags.map((tag: any, i: number) => (
                <Tag tag={tag} i={i} />
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ul>
  {
    referenceNotes.length > 0 && (
      <details class="reference-notes">
        <summary>
          Supporting references and clippings ({referenceNotes.length})
        </summary>
        <p>
          Source material collected for the notes above. These are usually best
          read from the note that links to them.
        </p>
        <ul>
          {referenceNotes.map((note) => (
            <li>
              <a href={`/${note.data.slug || note.id}`}>
                {noteStatusEmoji.reference} {note.data.title}
              </a>{" "}
              <time class="slab text-sm" datetime={note.data.created}>
                {formatPublishDate(note.data.created)}
              </time>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</MainLayout>
