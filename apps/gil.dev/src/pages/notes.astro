---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import {
  getDailyGardenSeed,
  isPublishedNote,
  isReferenceNote,
  noteStatusEmoji,
  seededShuffle,
} from "../lib/notes.ts";
import "../styles/global.css";

const notes = await getCollection("notes", ({ data }) => isPublishedNote(data));
const primaryNotes = seededShuffle(
  notes.filter(({ data }) => !isReferenceNote(data)),
  `all-notes-${getDailyGardenSeed()}`,
);
const referenceNotes = notes
  .filter(({ data }) => isReferenceNote(data))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const allTopics = await getCollection("topics");
const topicTitles = Object.fromEntries(
  allTopics.map((topic) => [topic.id, topic.data.title]),
);
const usedTopicIds = new Set(
  primaryNotes.flatMap((note) => note.data.topics ?? []),
);
const topicOptions = [...usedTopicIds]
  .map((id) => ({ id, title: topicTitles[id] ?? id }))
  .sort((a, b) => a.title.localeCompare(b.title));
const tagOptions = [
  ...new Set(primaryNotes.flatMap((note) => note.data.tags ?? [])),
].sort((a, b) => a.localeCompare(b));
const statusOptions = [
  ...new Set(primaryNotes.map((note) => note.data.status ?? "unstaged")),
].sort();
---

<MainLayout title="Explore All Notes" wide>
  <section class="garden-browser" data-garden-browser>
    <div class="garden-browser__intro">
      <p>
        Follow a topic, choose a stage, or shuffle the paths. Notes are arranged
        for discovery rather than by date.
      </p>
      <button type="button" class="garden-control-button" data-shuffle-notes>
        Shuffle paths ↻
      </button>
    </div>

    <div class="garden-filters" aria-label="Filter notes">
      <label>
        <span>Topic</span>
        <select data-filter-topic>
          <option value="">All topics</option>
          {
            topicOptions.map((topic) => (
              <option value={topic.id}>{topic.title}</option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Stage</span>
        <select data-filter-status>
          <option value="">All stages</option>
          {
            statusOptions.map((status) => (
              <option value={status}>
                {status === "unstaged"
                  ? "🪱 Unstaged"
                  : `${noteStatusEmoji[status]} ${status}`}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Tag</span>
        <select data-filter-tag>
          <option value="">All tags</option>
          {tagOptions.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
      </label>
      <label>
        <span>Order</span>
        <select data-note-order>
          <option value="wander">Garden paths</option>
          <option value="alphabetical">A–Z</option>
        </select>
      </label>
    </div>

    <p class="garden-result-count" aria-live="polite" data-result-count>
      {primaryNotes.length} notes to explore
    </p>

    <div class="garden-paths-grid" data-note-grid>
      {
        primaryNotes.map((note, index) => (
          <NoteCard note={note} topicTitles={topicTitles} index={index} />
        ))
      }
    </div>
  </section>

  {
    referenceNotes.length > 0 && (
      <details
        id="references"
        class="reference-notes"
        data-reference-notes
      >
        <summary>
          Supporting references and clippings ({referenceNotes.length})
        </summary>
        <p>
          Source material collected for the notes above. References are also
          available while browsing their tags.
        </p>
        <ul>
          {referenceNotes.map((note) => (
            <li>
              <a href={`/${note.data.slug || note.id}`}>
                {noteStatusEmoji.reference} {note.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</MainLayout>

<script>
  function initializeGardenBrowser() {
    document.querySelectorAll("[data-garden-browser]").forEach((browser) => {
      if (!(browser instanceof HTMLElement) || browser.dataset.ready) return;
      browser.dataset.ready = "true";

      const grid = browser.querySelector("[data-note-grid]");
      const cards = Array.from(browser.querySelectorAll("[data-note-card]"));
      const topicFilter = browser.querySelector("[data-filter-topic]");
      const statusFilter = browser.querySelector("[data-filter-status]");
      const tagFilter = browser.querySelector("[data-filter-tag]");
      const order = browser.querySelector("[data-note-order]");
      const count = browser.querySelector("[data-result-count]");
      const shuffle = browser.querySelector("[data-shuffle-notes]");
      const query = new URLSearchParams(window.location.search);
      const requestedTopic = query.get("topic");
      const requestedStatus = query.get("status");
      const requestedTag = query.get("tag");

      if (
        !(grid instanceof HTMLElement) ||
        !(topicFilter instanceof HTMLSelectElement) ||
        !(statusFilter instanceof HTMLSelectElement) ||
        !(tagFilter instanceof HTMLSelectElement) ||
        !(order instanceof HTMLSelectElement)
      ) return;

      const readList = (card: Element, key: string): string[] =>
        JSON.parse(card.getAttribute(`data-${key}`) || "[]");

      if (
        requestedTopic &&
        Array.from(topicFilter.options).some(
          (option) => option.value === requestedTopic,
        )
      ) {
        topicFilter.value = requestedTopic;
      }

      if (
        requestedStatus &&
        requestedStatus !== "reference" &&
        Array.from(statusFilter.options).some(
          (option) => option.value === requestedStatus,
        )
      ) {
        statusFilter.value = requestedStatus;
      }

      if (requestedStatus === "reference") {
        const references = document.querySelector("[data-reference-notes]");
        if (references instanceof HTMLDetailsElement) references.open = true;
      }

      if (
        requestedTag &&
        Array.from(tagFilter.options).some(
          (option) => option.value === requestedTag,
        )
      ) {
        tagFilter.value = requestedTag;
      }

      const render = () => {
        const visible = cards.filter((card) => {
          const matchesTopic =
            !topicFilter.value ||
            readList(card, "topics").includes(topicFilter.value);
          const matchesStatus =
            !statusFilter.value ||
            card.getAttribute("data-status") === statusFilter.value;
          const matchesTag =
            !tagFilter.value || readList(card, "tags").includes(tagFilter.value);
          return matchesTopic && matchesStatus && matchesTag;
        });

        cards.forEach((card) => {
          (card as HTMLElement).hidden = !visible.includes(card);
        });

        if (order.value === "alphabetical") {
          visible.sort((a, b) =>
            (a.getAttribute("data-title") || "").localeCompare(
              b.getAttribute("data-title") || "",
            ),
          );
        }
        visible.forEach((card) => grid.append(card));

        if (count) {
          count.textContent = `${visible.length} ${visible.length === 1 ? "note" : "notes"} to explore`;
        }
      };

      [topicFilter, statusFilter, tagFilter, order].forEach((control) =>
        control.addEventListener("change", render),
      );
      shuffle?.addEventListener("click", () => {
        order.value = "wander";
        cards
          .filter((card) => !(card as HTMLElement).hidden)
          .sort(() => Math.random() - 0.5)
          .forEach((card) => grid.append(card));
      });

      render();
    });
  }

  document.addEventListener("astro:page-load", initializeGardenBrowser);
  initializeGardenBrowser();
</script>

<style>
  .garden-browser__intro {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .garden-browser__intro p {
    max-width: 34rem;
    margin: 0;
    padding: 0;
    color: var(--subtle);
  }

  .garden-control-button {
    flex-shrink: 0;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--rose-readable);
    border-radius: 999px;
    color: var(--rose-readable);
    cursor: pointer;
    font-family: "Departure Mono", monospace;
    font-size: 0.58rem;
  }

  .garden-control-button:hover,
  .garden-control-button:focus-visible {
    background: var(--rose-readable);
    color: var(--surface);
  }

  .garden-filters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 0.75rem;
    border: 1px solid var(--highlight-med);
    border-radius: 0.65rem;
    background: var(--panel);
  }

  .garden-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--quiet);
    font-family: "Departure Mono", monospace;
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .garden-filters select {
    min-width: 0;
    padding: 0.35rem;
    border: 1px solid var(--highlight-high);
    border-radius: 0.35rem;
    background: var(--surface);
    color: var(--text);
    font-family: "Dank Mono", ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: none;
  }

  .garden-result-count {
    margin: 0.65rem 0;
    padding: 0;
    color: var(--quiet);
    font-size: 0.58rem;
  }

  .garden-paths-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .reference-notes {
    margin-top: 2.5rem;
    opacity: 0.72;
  }

  .reference-notes summary {
    font-size: 0.75rem;
  }

  .reference-notes p,
  .reference-notes ul {
    font-size: 0.65rem;
    line-height: 1.55;
  }

  @media (max-width: 850px) {
    .garden-filters,
    .garden-paths-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .garden-browser__intro {
      flex-direction: column;
    }

    .garden-filters,
    .garden-paths-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
