---
import { JSDOM } from "jsdom";

const { text } = Astro.props;
// Slots are serialized HTML: recover text before splitting it into characters.
// Astro escapes each character again when rendering, so markup stays inert.
const content = text ?? (Astro.slots.default
  ? JSDOM.fragment(await Astro.slots.render("default")).textContent
  : "");

// Split into words (discard the whitespace tokens — spacing is handled via CSS)
const words = String(content ?? "").split(/\s+/).filter(Boolean);

const wordGroups = words.map((word) => ({
  chars: [...word].map((char) => ({
    char,
    initialAngle: Math.random() * 10 - 5,
    duration: Math.random() + 0.5,
    delay: Math.random(),
  })),
}));
---

<style>
  @keyframes rotate {
    0% {
      transform: rotate(calc(var(--initial-angle) * 1deg));
    }
    50% {
      transform: rotate(calc(var(--initial-angle) * -1deg));
    }
    100% {
      transform: rotate(calc(var(--initial-angle) * 1deg));
    }
  }

  .rotating-char {
    display: inline-block;
    animation: rotate var(--duration) infinite;
    animation-timing-function: ease-in-out;
    animation-delay: var(--delay);
    min-width: 0.5em;
  }

  /* Keep words together when they fit; allow oversized words to wrap. */
  .word-group {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    margin-right: 0.3em;
  }
</style>

{
  wordGroups.map(({ chars }) => (
    <span class="word-group">
      {chars.map(({ char, initialAngle, duration, delay }) => (
        <span
          class="rotating-char"
          style={`--initial-angle: ${initialAngle}; --duration: ${duration}s; --delay: ${delay}s;`}
        >
          {char}
        </span>
      ))}
    </span>
  ))
}
