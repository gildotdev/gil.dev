{
  "name": "gil-dev-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter @gilcreque/gil.dev dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "new:note": "pnpm --filter @gilcreque/gil.dev new:note",
    "plugin:dev": "pnpm --filter @gilcreque/gil-publisher dev",
    "plugin:build": "pnpm --filter @gilcreque/gil-publisher build",
    "plugin:install": "pnpm --filter @gilcreque/gil-publisher install-plugin"
  }
}
